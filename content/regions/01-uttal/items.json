[
  { "id": "uttal:gast", "kind": "choice", "prompt": "gäst", "ask": "How does the g sound?", "hint": "guest", "answer": "like j", "options": ["like j", "hard g"], "say": "gäst", "explain": "G before a front vowel sounds like j.", "level": "A1", "lesson": 1, "tags": ["soft-g"] },
  { "id": "uttal:gora", "kind": "choice", "prompt": "göra", "ask": "How does the g sound?", "hint": "to do, to make", "answer": "like j", "options": ["like j", "hard g"], "say": "göra", "explain": "G before ö, a soft vowel, sounds like j: göra sounds like “jöra”.", "level": "A1", "lesson": 1, "tags": ["soft-g"] },
  { "id": "uttal:gata", "kind": "choice", "prompt": "gata", "ask": "How does the g sound?", "hint": "street", "answer": "hard g", "options": ["like j", "hard g"], "say": "gata", "explain": "G before a hard vowel (a, o, u, å) stays hard.", "level": "A1", "lesson": 1, "tags": ["soft-g"] },
  { "id": "uttal:gul", "kind": "choice", "prompt": "gul", "ask": "How does the g sound?", "hint": "yellow", "answer": "hard g", "options": ["like j", "hard g"], "say": "gul", "explain": "U is a hard vowel, so the g in gul stays hard.", "level": "A1", "lesson": 1, "tags": ["soft-g"] },
  { "id": "uttal:kopa", "kind": "choice", "prompt": "köpa", "ask": "How does the k sound?", "hint": "to buy", "answer": "like tj", "options": ["like tj", "hard k"], "say": "köpa", "explain": "K before a front vowel (e, i, y, ä, ö) sounds like tj.", "level": "A1", "lesson": 1, "tags": ["soft-k"] },
  { "id": "uttal:kyrka", "kind": "choice", "prompt": "kyrka", "ask": "How does the first k sound?", "hint": "church", "answer": "like tj", "options": ["like tj", "hard k"], "say": "kyrka", "explain": "The first k comes before y, a soft vowel, so it sounds like tj; the second k comes before a and stays hard.", "level": "A1", "lesson": 1, "tags": ["soft-k"] },
  { "id": "uttal:katt", "kind": "choice", "prompt": "katt", "ask": "How does the k sound?", "hint": "cat", "answer": "hard k", "options": ["like tj", "hard k"], "say": "katt", "explain": "K before a hard vowel (a, o, u, å) stays hard.", "level": "A1", "lesson": 1, "tags": ["soft-k"] },
  { "id": "uttal:sked", "kind": "choice", "prompt": "sked", "ask": "How does sk sound?", "hint": "spoon", "answer": "like sh", "options": ["like sh", "like sk"], "say": "sked", "explain": "Sk before a front vowel (e, i, y, ä, ö) sounds like sh.", "level": "A1", "lesson": 1, "tags": ["soft-sk"] },
  { "id": "uttal:skola", "kind": "choice", "prompt": "skola", "ask": "How does sk sound?", "hint": "school", "answer": "like sk", "options": ["like sh", "like sk"], "say": "skola", "explain": "Sk before a hard vowel (a, o, u, å) stays sk.", "level": "A1", "lesson": 1, "tags": ["soft-sk"] },
  { "id": "uttal:skjorta", "kind": "choice", "prompt": "skjorta", "ask": "How does skj sound?", "hint": "shirt", "answer": "like sh", "options": ["like sh", "like sk"], "say": "skjorta", "explain": "Skj always sounds like sh, whatever vowel comes after.", "level": "A1", "lesson": 1, "tags": ["sj-sound"] },
  { "id": "uttal:sju", "kind": "choice", "prompt": "sju", "ask": "How does sj sound?", "hint": "seven", "answer": "like sh", "options": ["like sh", "like s + j"], "say": "sju", "explain": "Sj always sounds like sh.", "level": "A1", "lesson": 1, "tags": ["sj-sound"] },
  { "id": "uttal:tjugo", "kind": "choice", "prompt": "tjugo", "ask": "Which word starts with the same sound?", "hint": "twenty", "answer": "kök", "options": ["kök", "katt", "skola"], "say": "tjugo", "explain": "Tj always sounds like tj, and so does k before ö: tjugo and kök start with the same sound.", "level": "A1", "lesson": 1, "tags": ["tj-sound", "soft-k"] },
  { "id": "uttal:hjalp", "kind": "choice", "prompt": "hjälp", "ask": "How does hj sound?", "hint": "help", "answer": "like j", "options": ["like j", "like h + j"], "say": "hjälp", "explain": "In hj at the start of a word the h is silent, so hjälp starts with a j sound.", "level": "A1", "lesson": 1, "tags": ["j-sound"] },
  { "id": "uttal:djur", "kind": "choice", "prompt": "djur", "ask": "How does dj sound?", "hint": "animal", "answer": "like j", "options": ["like j", "like d + j"], "say": "djur", "explain": "In dj at the start of a word the d is silent, so djur starts with a j sound.", "level": "A1", "lesson": 1, "tags": ["j-sound"] },
  { "id": "uttal:ljus", "kind": "choice", "prompt": "ljus", "ask": "How does lj sound?", "hint": "light", "answer": "like j", "options": ["like j", "like l + j"], "say": "ljus", "explain": "In lj at the start of a word the l is silent, so ljus starts with a j sound.", "level": "A1", "lesson": 1, "tags": ["j-sound"] },
  { "id": "uttal:kurs", "kind": "choice", "prompt": "kurs", "ask": "How does rs sound?", "hint": "course", "answer": "like sh", "options": ["like sh", "like s"], "say": "kurs", "explain": "R + s blends into one sh sound.", "level": "A1", "lesson": 1, "tags": ["rs"] },
  { "id": "uttal:tak-long", "kind": "choice", "prompt": "tak", "ask": "Is the vowel long or short?", "hint": "roof", "answer": "long", "options": ["long", "short"], "say": "tak", "explain": "One consonant after the vowel makes it long: tak has a long a.", "level": "A1", "lesson": 1, "tags": ["vowel-length"] },
  { "id": "uttal:tack-short", "kind": "choice", "prompt": "tack", "ask": "Is the vowel long or short?", "hint": "thank you", "answer": "short", "options": ["long", "short"], "say": "tack", "explain": "A double consonant after the vowel makes it short: tack has a short a.", "level": "A1", "lesson": 1, "tags": ["vowel-length"] },
  { "id": "uttal:vagg-short", "kind": "choice", "prompt": "vägg", "ask": "Is the vowel long or short?", "hint": "wall", "answer": "short", "options": ["long", "short"], "say": "vägg", "explain": "Gg is a double consonant, so the ä in vägg is short.", "level": "A1", "lesson": 1, "tags": ["vowel-length"] },
  { "id": "uttal:kafe-stress", "kind": "choice", "prompt": "kafé", "ask": "Where is the stress?", "hint": "café (the place)", "answer": "final syllable", "options": ["first syllable", "final syllable"], "say": "kafé", "explain": "Kafé comes from French and is stressed on the last syllable, the é.", "level": "A1", "lesson": 1, "tags": ["stress"] },
  { "id": "uttal:kaffe-stress", "kind": "choice", "prompt": "kaffe", "ask": "Where is the stress?", "hint": "coffee (the drink)", "answer": "first syllable", "options": ["first syllable", "final syllable"], "say": "kaffe", "explain": "Most Swedish words, like kaffe, are stressed on the first syllable.", "level": "A1", "lesson": 1, "tags": ["stress"] },
  { "id": "uttal:mouth-y", "kind": "choice", "prompt": "ny", "ask": "How do you make the y sound?", "hint": "new", "answer": "mouth for u, say i", "options": ["mouth for u, say i", "mouth for o, say e"], "say": "ny", "explain": "For y, round your lips as for u but say i.", "level": "A1", "lesson": 1, "tags": ["vowels"] },
  { "id": "uttal:mouth-o", "kind": "choice", "prompt": "söt", "ask": "How do you make the ö sound?", "hint": "sweet", "answer": "mouth for o, say e", "options": ["mouth for u, say i", "mouth for o, say e"], "say": "söt", "explain": "For ö, round your lips as for o but say e.", "level": "A1", "lesson": 1, "tags": ["vowels"] },
