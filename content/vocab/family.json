      }
    },
    {
      "id": "vocab:family:skilja-sig",
      "sv": "skilja sig",
      "en": "get divorced",
      "pos": "verb",
      "level": "A1",
      "lesson": 10,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Mina föräldrar ville skilja sig, men båda ville ha katten. Så de stannade tillsammans.",
        "en": "My parents wanted to divorce, but both wanted the cat. So they stayed together."
      }
    },
    {
