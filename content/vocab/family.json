      "en": "grandfather (mother’s father)",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "morfadern",
        "pl": "morfäder",
        "defPl": "morfäderna"
      },
      "group": 3,
      "level": "A1",
