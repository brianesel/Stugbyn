{
  "theme": "family",
  "title": "Familj och relationer",
  "entries": [
    {
      "id": "vocab:family:van",
      "sv": "vän",
      "en": "friend",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "vännen",
        "pl": "vänner",
        "defPl": "vännerna"
      },
      "group": 3,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min bästa vän är min kaffebryggare. Den väcker mig varje morgon.",
        "en": "My best friend is my coffee maker. It wakes me up every morning."
      }
    },
    {
      "id": "vocab:family:pojkvan",
      "sv": "pojkvän",
      "en": "boyfriend",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "pojkvännen",
        "pl": "pojkvänner",
        "defPl": "pojkvännerna"
      },
      "group": 3,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "– Har du en pojkvän? – Nej, jag har en katt. Den klagar mindre.",
        "en": "“Do you have a boyfriend?” “No, I have a cat. It complains less.”"
      }
    },
    {
      "id": "vocab:family:flickvan",
      "sv": "flickvän",
      "en": "girlfriend",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "flickvännen",
        "pl": "flickvänner",
        "defPl": "flickvännerna"
      },
      "group": 3,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min flickvän säger att jag pratar för mycket svenska. På finska.",
        "en": "My girlfriend says I speak too much Swedish. In Finnish."
      }
    },
    {
      "id": "vocab:family:sambo",
      "sv": "sambo",
      "en": "partner (living together)",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "sambon",
        "pl": "sambor",
        "defPl": "samborna"
      },
      "group": 3,
      "level": "A1",
      "lesson": 2,
      "example": {
        "sv": "Jag bor med min sambo.",
        "en": "I live with my partner."
      },
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min sambo och jag delar allt. Utom choklad.",
        "en": "My partner and I share everything. Except chocolate."
      }
    },
    {
      "id": "vocab:family:sarbo",
      "sv": "särbo",
      "en": "partner (living apart)",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "särbon",
        "pl": "särbor",
        "defPl": "särborna"
      },
      "group": 3,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Vi är särbor. Det är perfekt: två kylskåp.",
        "en": "We’re a couple living apart. It’s perfect: two fridges."
      }
    },
    {
      "id": "vocab:family:gift",
      "sv": "gift",
      "en": "married",
      "pos": "adjective",
      "level": "A1",
      "lesson": 2,
      "example": {
        "sv": "Är du gift?",
        "en": "Are you married?"
      },
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "– Är svampen giftig? – Nej, inte ens gift. Den är singel.",
        "en": "“Is the mushroom poisonous?” “No, not even married. It’s single.”",
        "note": "Pun: gift means ‘married’, but ett gift is ‘a poison’ (giftig = poisonous)."
      }
    },
    {
      "id": "vocab:family:man",
      "sv": "man",
      "en": "husband; man",
      "enPl": "husbands; men",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "mannen",
        "pl": "män",
        "defPl": "männen"
      },
      "group": 5,
      "irregular": true,
      "level": "A1",
      "lesson": 2,
      "note": "Irregular: en man, mannen, män, männen.",
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min man kan laga allt. Utom mat.",
        "en": "My husband can fix anything. Except food.",
        "note": "Laga means ‘fix’, and laga mat means ‘cook’."
      }
    },
    {
      "id": "vocab:family:fru",
      "sv": "fru",
      "en": "wife",
      "enPl": "wives",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "frun",
        "pl": "fruar",
        "defPl": "fruarna"
      },
      "group": 2,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min fru har alltid rätt. Även när hon sover.",
        "en": "My wife is always right. Even when she’s asleep."
      }
    },
    {
      "id": "vocab:family:maka",
      "sv": "maka",
      "en": "spouse (wife)",
      "enPl": "spouses (wives)",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "makan",
        "pl": "makor",
        "defPl": "makorna"
      },
      "group": 1,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Hans maka bestämmer hemma. Utom på lördagar. Då bestämmer katten.",
        "en": "His wife makes the decisions at home. Except on Saturdays. Then the cat decides."
      }
    },
    {
      "id": "vocab:family:make",
      "sv": "make",
      "en": "spouse (husband)",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "maken",
        "pl": "makar",
        "defPl": "makarna"
      },
      "group": 2,
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min make letar efter strumpans make.",
        "en": "My husband is looking for the sock’s other half.",
        "note": "Make means ‘husband’ and also ‘the other one of a pair’."
      }
    },
    {
      "id": "vocab:family:barn",
      "sv": "barn",
      "en": "child",
      "enPl": "children",
      "pos": "noun",
      "gender": "ett",
      "forms": {
        "def": "barnet",
        "pl": "barn",
        "defPl": "barnen"
      },
      "group": 5,
      "level": "A1",
      "lesson": 2,
      "example": {
        "sv": "Vi har två barn.",
        "en": "We have two children."
      },
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Barn är som katter: de vaknar klockan fem och vill ha mat.",
        "en": "Children are like cats: they wake up at five and want food."
      }
    },
    {
      "id": "vocab:family:son",
      "sv": "son",
      "en": "son",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "sonen",
        "pl": "söner",
        "defPl": "sönerna"
      },
      "group": 3,
      "level": "A1",
      "lesson": 2,
      "note": "Vowel change: son → söner.",
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Min son är fem år och vet allt. Jag är fyrtio och vet ingenting.",
        "en": "My son is five and knows everything. I’m forty and know nothing."
      }
    },
    {
      "id": "vocab:family:dotter",
      "sv": "dotter",
      "en": "daughter",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "dottern",
