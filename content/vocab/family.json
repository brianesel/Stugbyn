        "yki-relationships"
      ],
      "fun": {
        "sv": "Min dotter lär mig svenska. Hon tar betalt i glass.",
        "en": "My daughter teaches me Swedish. She charges in ice cream."
      }
    },
    {
      "id": "vocab:family:bror",
      "sv": "bror",
      "en": "brother",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "brodern",
        "pl": "bröder",
        "defPl": "bröderna"
