    {
      "id": "vocab:family:singel",
      "sv": "singel",
      "en": "single",
      "pos": "adjective",
      "level": "A1",
      "lesson": 2,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "– Är du singel? – Nej, jag har en katt och tre krukväxter.",
        "en": "“Are you single?” “No, I have a cat and three houseplants.”"
      }
    },
    {
      "id": "vocab:family:skild",
      "sv": "skild",
      "en": "divorced",
      "pos": "adjective",
      "level": "A1",
      "lesson": 10,
      "tags": [
        "yki-relationships"
      ],
      "fun": {
        "sv": "Mina strumpor är skilda. Den ena bor i tvättmaskinen nu.",
