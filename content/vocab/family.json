      "id": "vocab:family:pappa",
      "sv": "pappa",
      "en": "dad",
      "pos": "noun",
      "gender": "en",
      "forms": {
        "def": "pappan",
        "pl": "pappor",
        "defPl": "papporna"
      },
      "group": 1,
      "level": "A1",
      "lesson": 2,
      "tags": [
