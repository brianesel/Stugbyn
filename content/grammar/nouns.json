{
  "groups": {
    "1": {"ending": "-or", "label": "Group 1", "rule": "En-words that end in -a drop the a and add -or: flicka → flickor."},
    "2": {"ending": "-ar", "label": "Group 2", "rule": "Short concrete en-words, en-words with an e in one of the last two letters, and -ing words add -ar: bil → bilar, pojke → pojkar, tidning → tidningar."},
    "3": {"ending": "-er / -r", "label": "Group 3", "rule": "Long en-words, words from other languages and words stressed on the last syllable add -er; en-words ending in a vowel other than a add -r: telefon → telefoner, sko → skor."},
    "4": {"ending": "-n", "label": "Group 4", "rule": "Ett-words that end in a vowel add -n: äpple → äpplen."},
    "5": {"ending": "no ending", "label": "Group 5", "rule": "Ett-words that end in a consonant, and en-words for people ending in -are or -er, stay the same: ett hus → två hus, en lärare → två lärare."}
  },
  "explain": {
    "gender": "It’s {art} {sv}. Learn the article together with the word.",
    "def_en": "En-words end in -en or -n in the definite form: en {sv} → {def}.",
    "def_ett": "Ett-words end in -et or -t in the definite form: ett {sv} → {def}.",
    "pl": "Group {group} ({ending}): {sv} → {pl}.",
    "defPl_1": "Groups 1–3 add -na to the plural: {pl} → {defPl}.",
    "defPl_2": "Groups 1–3 add -na to the plural: {pl} → {defPl}.",
    "defPl_3": "Groups 1–3 add -na to the plural: {pl} → {defPl}.",
    "defPl_4": "Group 4 adds -a to the plural: {pl} → {defPl}.",
    "defPl_5": "Group 5 ett-words add -en to the plural: {pl} → {defPl}."
  },
  "say": {"pl": "{art} {sv} – två {pl}"},
