  "groups": {
    "1": { "label": "Group I", "rule": "Infinitive ends in -a, present in -ar. Past +de, supine +t: jobba → jobbade, jobbat." },
    "2": { "label": "Group II", "rule": "Present ends in -er. Past +de, or +te after p, k, t, s, x (PocKeTS + X): stängde, köpte. Supine -t: stängt, köpt." },
    "3": { "label": "Group III", "rule": "Short verbs ending in a vowel. Past +dde, supine +tt: bo → bodde, bott." },
    "4": { "label": "Group IV", "rule": "Irregular: the vowel often changes. Learn the forms by heart: skriva → skrev, skrivit." }
  },
  "frames": {
    "help": [
      { "sv": "Jag kan ___ {object}.", "en": "I can {en} {objectEn}." },
