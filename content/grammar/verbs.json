      { "sv": "Jag ska ___ {object}.", "en": "I’m going to {en} {objectEn}." }
    ],
    "present": [{ "sv": "Anna ___ {object}.", "en": "Anna {en3} {objectEn}." }],
    "past": [{ "sv": "{time} ___ jag {object}.", "en": "{timeEn} I {enPast} {objectEn}." }],
    "perfect": [{ "sv": "Jag har ___ {object}.", "en": "I have {enPp} {objectEn}." }],
    "bare": { "sv": "{inf} → ___" }
  },
  "defaultTime": { "sv": "Igår", "en": "Yesterday" },
  "explain": {
    "help": "After a help verb, use the infinitive: {help} {inf}.",
    "present": "A subject and no help verb, so use the present tense: Anna {pres}.",
    "past_1": "Group I: present -ar, past +de: {pres} → {past}.",
    "past_2": "Group II: +de, or +te after p, k, t, s, x (PocKeTS + X): {inf} → {past}.",
    "past_3": "Group III: short verbs add -dde: {inf} → {past}.",
    "past_4": "Group IV is irregular: {inf} → {past}. Learn it by heart.",
    "sup_1": "Group I: supine +t: {inf} → {sup}.",
    "sup_2": "Group II: supine ends in -t: {inf} → {sup}.",
    "sup_3": "Group III: supine +tt: {inf} → {sup}.",
    "sup_4": "Group IV is irregular: {inf} → {sup}. Learn it by heart."
  },
