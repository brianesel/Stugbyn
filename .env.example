# Copy to .env.local for local development, and set the same two values in your host’s build settings.
# Both are public by design; row level security in supabase/schema.sql protects each user’s data.
# Leave them empty to run without accounts (progress stays on the device).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
