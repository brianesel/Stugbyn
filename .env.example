# Copy to .env.local for local development, and set the same two values in your host’s build settings.
# Both are public by design; row level security in supabase/schema.sql protects each user’s data.
# Leave them empty to run without accounts (progress stays on the device).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Writing helper (optional). Server-only: never prefix it with VITE_, or it would be bundled into the app.
# Locally `npm run dev` reads it from .env.local; on Vercel add it under Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Optional: only these emails may use the helper (comma-separated). Empty = every signed-in user.
ASSISTANT_ALLOWED_EMAILS=
